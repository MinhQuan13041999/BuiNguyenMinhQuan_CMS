# ==============================================================================
# WordPress Root .gitignore
# ==============================================================================

# Database & Sensitive Configuration
wp-config.php
wp-config-local.php
*.bak

# Logs
*.log
debug.log
error_log

# Cache files and temporary files
*.cache
cache/
*.tmp

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
.project
.settings/
.buildpath

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini